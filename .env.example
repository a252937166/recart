# ReCart server configuration. Copy to .env (never commit it) and load it before `npm start`.
PORT=4060
HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:4060
# Matches `npm run dev:db` (embedded PostgreSQL); use your own database and password in production.
DATABASE_URL=postgres://recart:recart-dev@127.0.0.1:5434/recart

# PayPal Sandbox REST app (Developer Dashboard > Apps & Credentials > Sandbox). Server-side only.
PAYPAL_MODE=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_SDK_ORIGIN=https://www.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# ID of the webhook you register for this app; incoming events are verified against it.
PAYPAL_WEBHOOK_ID=
# Local lost-response recording only (PP04). The server refuses to start with 1 unless it is loopback-only.
PAYPAL_FAULT_INJECTION=0

# Primary language provider: the owner's Codex API gateway (OpenAI-compatible, one request at a time; 28–60 s per
# call). From the demo host it is reached on loopback. Leave empty to use the hosted endpoint below, or neither for
# the rules/template fallbacks.
CODEX_API_URL=
CODEX_API_KEY=
CODEX_MODEL=
CODEX_EFFORT=
CODEX_DEADLINE_SECONDS=100
CODEX_EXPLAIN_DEADLINE_SECONDS=150
LANGUAGE_PROVIDER=auto
LANGUAGE_COOLDOWN_SECONDS=60
# Backup language endpoint (hosted-agent/ on Astropods), used only when the Codex gateway cannot answer.
LANGUAGE_URL=
LANGUAGE_TOKEN=

# judge: 5-minute quote, 15-minute PayPal approval, 60-minute store confirmation. test: 15-minute confirmation.
TIMING_PRESET=judge
WORKER_ENABLED=true
# true behind HTTPS
COOKIE_SECURE=false

# Sandbox Personal buyer logins shown in the judge guide, as email:password pairs separated by ';'.
# Quote the value when sourcing it from a shell, e.g. JUDGE_BUYERS='a@personal.example.com:pw1;b@personal.example.com:pw2'
JUDGE_BUYERS=
REPO_URL=
VIDEO_URL=

# Merchant platform. Self-serve sandbox stores (developers page) and how long they live.
SANDBOX_SIGNUP=true
SANDBOX_TTL_HOURS=72
SANDBOX_SIGNUPS_PER_HOUR=30
# Who may set X-Forwarded-For: "loopback" (a reverse proxy on this host, the production layout), proxy IPs or CIDRs
# separated by commas, or "none" when clients reach the app directly. Any other setting lets callers choose the
# address their quotas are counted against.
TRUST_PROXY=loopback
# Quotas per client address and hour. Demo sessions, AI drafts and sandbox sign-ups are counted separately; each 429
# carries Retry-After and the reset time.
DEMO_SESSIONS_PER_HOUR=100
LANGUAGE_CALLS_PER_HOUR=200
# Operator merchants whose aggregate integration status is public on /merchants (comma-separated IDs).
REFERENCE_MERCHANT_IDS=
# Tests only: allow merchant webhooks to loopback URLs. Keep false in production.
WEBHOOK_ALLOW_LOOPBACK=false
# Shown in the footer and /api/health.
RELEASE_ID=dev
